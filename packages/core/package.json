{
  "name": "@multitap/core",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "dev"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "dev": "node --conditions=development --watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "node --conditions=development src/cli.ts",
    "openapi": "node --conditions=development src/openapi.ts ../../packages/api/openapi.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@multitap/addon-protocol": "workspace:*",
    "@multitap/api": "workspace:*",
    "@prometheus-io/client": "0.16.1",
    "@types/better-sqlite3": "9.6.0",
    "@viren070/parse-torrent-title": "0.9.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "pino": "10.3.1",
    "pino-roll": "4.0.0",
    "undici": "8.10.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "hls.js": "1.7.3",
    "pino-pretty": "13.1.3"
  }
}
